NEXT_PUBLIC_IS_PLATFORM=true
NEXT_PUBLIC_API_URL=http://localhost:8082/api
NEXT_PUBLIC_GOTRUE_URL=http://localhost:8082/api/mock-auth/v1
NEXT_PUBLIC_SITE_URL=http://localhost:8082
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_MOCK_BACKEND=true

# Optional: pull readings from an external API on the server (see lib/twin/poll-presets.ts).
# TWIN_POLL_PRESET=iss            # public demo API, needs internet: iss | local-pumps
# TWIN_POLL_URL=https://your-api.example.com/sensors
# TWIN_POLL_MAPPING_FILE=poll-mapping.json
# TWIN_POLL_HEADERS={"Authorization":"Bearer <token>"}
# TWIN_POLL_INTERVAL_SEC=5
